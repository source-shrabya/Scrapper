# Environment Configuration Template
# Copy this to .env and fill in your actual credentials

# OpenAI API key (required for vision extraction)
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Anti-bot proxy services
# Choose one if using proxy for bypassing detection
BROWSERLESS_API_KEY=your-browserless-key
SCRAPINGBEE_API_KEY=your-scrapingbee-key

# Scraper settings
USE_PROXY=false
HEADLESS_BROWSER=true
BROWSER_TIMEOUT=30000

# Probability engine settings
MIN_DEAL_PROBABILITY=60.0  # Minimum probability to consider a good deal
MIN_EQUITY_PERCENT=50.0    # Minimum equity % for deals

# Data directories
DATA_DIR=./data
OUTPUT_DIR=./data/output
CONFIG_DIR=./data/county_configs

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/scraper.log

# Rate limiting (seconds)
DELAY_BETWEEN_CLICKS=0.5
DELAY_BETWEEN_SEARCHES=1.0
